# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (safe: publishable only).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Build-time only (not bundled):
APP_VARIANT=guest
BRAND_NAME=Water Uber
BUNDLE_ID_BASE=com.roatanexperience.watertaxi
GOOGLE_MAPS_ANDROID_KEY=
EAS_PROJECT_ID=

# Server secrets live in Supabase, NOT here:
#   supabase secrets set ANTHROPIC_API_KEY=... PAYMENT_PROVIDER=... PAYMENT_WEBHOOK_SECRET=...
