# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (safe: publishable only).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Build-time only (not bundled):
APP_VARIANT=guest
BRAND_NAME=Water Uber
BUNDLE_ID_BASE=com.roatanexperience.watertaxi
GOOGLE_MAPS_ANDROID_KEY=
EAS_PROJECT_ID=

# Public web address of the no-download booking site (QR codes and links point here).
EXPO_PUBLIC_WEB_URL=https://wateruber.app

# Server secrets live in Supabase, NOT here (see docs/PAYMENTS.md):
#   supabase secrets set ANTHROPIC_API_KEY=... PUBLIC_WEB_URL=https://wateruber.app
#   supabase secrets set PAYMENT_PROVIDER=stripe STRIPE_SECRET_KEY=sk_... STRIPE_WEBHOOK_SECRET=whsec_...
